{
  "schema_version": 1,
  "providers": [
    {
      "id": "tmdb",
      "name": "TMDB",
      "base_url": "https://api.themoviedb.org/3",
      "auth": "query",
      "auth_key": "api_key",
      "enabled": true,
      "requests": [
        {"id": "popular_movies", "url": "/movie/popular", "media_type": "movie"},
        {"id": "popular_series", "url": "/tv/popular", "media_type": "series"},
        {"id": "new_movies", "url": "/movie/now_playing", "media_type": "movie"},
        {"id": "new_series", "url": "/tv/airing_today", "media_type": "series"},
        {"id": "upcoming_movies", "url": "/movie/upcoming", "media_type": "movie"},
        {"id": "upcoming_series", "url": "/tv/on_the_air", "media_type": "series"}
      ]
    },
    {
      "id": "trakt",
      "name": "Trakt",
      "base_url": "https://api.trakt.tv",
      "auth": "header",
      "auth_key": "trakt-api-key",
      "enabled": false,
      "requests": [
        {"id": "trending_movies", "url": "/movies/trending", "media_type": "movie"},
        {"id": "trending_series", "url": "/shows/trending", "media_type": "series"}
      ]
    },
    {
      "id": "cinemeta",
      "name": "Cinemeta",
      "base_url": "https://v3-cinemeta.strem.io",
      "auth": "none",
      "enabled": false,
      "requests": [
        {"id": "top_movies", "url": "/movie/top.json", "media_type": "movie"},
        {"id": "top_series", "url": "/series/top.json", "media_type": "series"}
      ]
    }
  ]
}
